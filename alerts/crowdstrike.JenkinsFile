pipeline {

    agent any

    environment {
        IMAGE_TAG = "dev"
        IMAGE_NAME = "crowdstrike"
        PROJECT_NAME = "crowdstrike"
        FOLDER_PATH = 'apps/alertbase'
        BRANCH = 'feature/pipeline-action-test'
    }

    stages {

        // Clone the project
        stage('Clone the project') {
            steps {
                script {
                    dir('repo') {
                        def checkoutRepo = load './checkout.groovy'
                        checkoutRepo.checkoutToXDRRepo('feature/pipeline-action-test', 'apps/alertbase')
                    }
                }
            }
        }

        // Building the project
        stage('Building docker image') {
            steps {
                sh 'ls -lah'
                dir('repo/apps/alertbase') {
                    sh "./local-build.sh -n=${env.IMAGE_NAME}:${env.IMAGE_TAG} -p=${env.PROJECT_NAME}"
                }
            }
        }

        // Publishing built image
        stage('Publishing built image') {
            steps {
                script {
                    def publisher = load './publish.groovy'
                    publisher.publishDockerImage(env.IMAGE_NAME, env.IMAGE_TAG)
                }
            }
        }
    }
}
